# ── Node-only ──
NODE_ENV=development

# ── Database (same names as Spring backend/.env.example) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lardermind
DB_USERNAME=postgres
DB_PASSWORD=postgres
# use "disable" for local Docker Postgres; Railway/Supabase/Render usually need "require"
DB_SSL_MODE=disable
# Supabase: use pooler port 6543 (transaction), not 5432 (session, ~15 client cap)
# DB_PORT=6543
DB_POOL_SIZE=2
DB_POOL_MIN_IDLE=1

# ── JWT (min 32 chars for HS256) ──
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime in seconds (default 30 days)
JWT_EXPIRES_IN_SECONDS=2592000

# ── Google OAuth (must match frontend VITE_GOOGLE_CLIENT_ID) ──
# Empty is allowed to boot; Google login fails until set.
GOOGLE_CLIENT_ID=

# ── Cloudinary (Wave 2) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── DeepSeek LLM (Wave 2) ──
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4096

# ── OpenAI vision (pantry image recognition) ──
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_VISION_TIMEOUT_MS=60000

# ── Chat / LangGraph ──
# Mutating-tool human approval (default true except NODE_ENV=test)
CHAT_HITL_ENABLED=true
# Max agent↔tool loop steps
CHAT_RECURSION_LIMIT=12
# Use in-process MemorySaver instead of Postgres checkpointer
CHAT_USE_MEMORY_CHECKPOINTER=false

# ── Stripe (Wave 2, optional) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ── CORS (comma-separated) ──
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ── Frontend URL (OAuth redirects etc.) ──
FRONTEND_URL=http://localhost:5173

# ── Server ──
# Spring uses 8080; Expo Metro often uses 8081 — Nest defaults to 8090.
PORT=8090

# ── Unsplash / imports (Wave 2, optional) ──
UNSPLASH_ACCESS_KEY=
YOUTUBE_API_KEY=
SOCIAL_IMPORT_API_KEY=
SOCIAL_IMPORT_BASE_URL=https://api.socialkit.dev
