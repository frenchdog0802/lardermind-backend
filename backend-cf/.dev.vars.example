# Copy to .dev.vars for local wrangler dev (never commit .dev.vars)
JWT_SECRET=change-me-to-at-least-32-characters-long
# AI Gateway Authenticated Gateway token (cf-aig-authorization)
CF_AIG_TOKEN=
